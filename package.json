{
  "name": "gradfolio-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Gradfolio, a student portfolio platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/api/main.js",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "migrate": "tsx --env-file-if-exists=.env src/core/db/migrator/cli.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/core/db/migrator/cli.ts down",
    "db:schema": "tsx --env-file-if-exists=.env src/core/db/migrator/dump-cli.ts",
    "db:types": "kysely-codegen --config-file .kysely-codegenrc.json",
    "db:types:check": "kysely-codegen --config-file .kysely-codegenrc.json --verify",
    "db:seed": "tsx --env-file-if-exists=.env src/core/db/seed/cli.ts",
    "openapi": "tsx src/api/openapi/cli.ts",
    "openapi:check": "tsx src/api/openapi/cli.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run openapi:check && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.4",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
