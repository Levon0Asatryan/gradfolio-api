# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug
# json (default) or pretty; pretty needs devDependencies, so local `npm run dev` only.
LOG_FORMAT=pretty

API_PORT=3000
# Largest accepted JSON body. Project descriptions are the biggest payload.
API_BODY_LIMIT=256kb
# Swagger UI at /docs. Off unless set.
API_DOCS_ENABLED=true
# How many proxies in front of the api to believe about the client address:
# false, or a hop count (1 behind one reverse proxy). Never true: that believes
# the left-most X-Forwarded-For entry, which the client writes.
TRUST_PROXY=false
HEALTH_TIMEOUT_MS=3000

# Auth0 (docs/ops/auth0-setup.md). The issuer is the tenant with a trailing slash;
# the audience is the API identifier. Neither is secret.
AUTH0_ISSUER_BASE_URL=https://dev-xxxxxxxx.eu.auth0.com/
AUTH0_AUDIENCE=https://api.gradfolio.app
# How long a key-set fetch may take before requests answer 503.
AUTH0_JWKS_TIMEOUT_MS=3000
# Accepted clock skew for exp/nbf, in seconds.
AUTH0_CLOCK_TOLERANCE_S=5

# Requests per window, per route, per caller (user when signed in, else address).
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_DEFAULT=120
# Budgets only routes marked @RateBudget('search' | 'import' | 'ai') use.
RATE_LIMIT_SEARCH=30
RATE_LIMIT_IMPORT=5
RATE_LIMIT_AI=10

# `docker compose up -d mysql` serves this on host port 3307.
DATABASE_URL=mysql://gradfolio:gradfolio@127.0.0.1:3307/gradfolio
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# A Unix socket to the database, such as Cloud Run's /cloudsql/<project>:<region>:<instance>.
# Replaces the host and port of DATABASE_URL (user, password and database still come
# from it). TLS does not apply: DATABASE_SSL must stay off when this is set.
# DATABASE_SOCKET_PATH=
# `required` for a database reached over the network (enforced when NODE_ENV=production
# without a socket). Optionally pin the server's CA certificate (PEM contents) instead
# of the system trust store.
DATABASE_SSL=off
# DATABASE_SSL_CA=

# Seconds `npm run migrate` waits for another migration on the same database.
MIGRATION_LOCK_TIMEOUT_S=60

# Integration tests only; defaults to this value.
# TEST_DATABASE_URL=mysql://gradfolio:gradfolio@127.0.0.1:3307/gradfolio_test

# Projects listed on one profile (own and accepted-team together).
PROFILE_PROJECTS_LIMIT=50
# Entries per profile section (education, experience, certifications), and skills.
PROFILE_MAX_SECTION_ITEMS=50
PROFILE_MAX_SKILLS=100

# GitHub connect (docs/modules/m7/plan.md §8). All optional: with any of the five
# credentials unset, every GitHub route answers 503 INTEGRATION_UNAVAILABLE.
# The `Gradfolio` application's client id (audience of the link id token).
# AUTH0_CLIENT_ID=
# The machine-to-machine app with read:user_idp_tokens and update:users. Set both
# or neither; the secret belongs in Secret Manager, never in a committed file.
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=
# The GitHub OAuth App behind Auth0's GitHub connection: disconnect revokes the
# grant with it (D9). Set both or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_API_BASE_URL=https://api.github.com/
# GITHUB_TIMEOUT_MS=10000
# Seconds a GitHub token read from Auth0 stays in memory (0 = off, max 900), and how many.
# GITHUB_TOKEN_CACHE_S=300
# GITHUB_TOKEN_CACHE_MAX=1000
# One Management API call's timeout, and the spacing between calls (Free tenant: 2/s).
# AUTH0_MANAGEMENT_TIMEOUT_MS=5000
# AUTH0_MANAGEMENT_SPACING_MS=500
# Repository import: page size ceiling, repositories per import (max 10), README bytes
# read (over it the project is created without a description), repositories read at once.
# GITHUB_PAGE_MAX=30
# GITHUB_IMPORT_MAX_BATCH=10
# GITHUB_README_MAX_BYTES=400000
# GITHUB_SEARCH_SCAN_PAGES=5
# GITHUB_IMPORT_CONCURRENCY=2
# A link nonce's lifetime, and the oldest `iat` a link id token may carry.
# INTEGRATION_NONCE_TTL_S=600
# LINK_ID_TOKEN_MAX_AGE_S=300
# RATE_LIMIT_INTEGRATION=30

# Suggestions (docs/modules/m7/plan.md §6): the refresh floor per student (seconds), open
# suggestions one student may hold, page sizes, and when a LinkedIn export import is old.
# SUGGESTIONS_MIN_INTERVAL_S=900
# SUGGESTIONS_MAX_OPEN=50
# SUGGESTIONS_LANGUAGE_REPOS=5
# SUGGESTIONS_PAGE_SIZE=20
# SUGGESTIONS_PAGE_MAX=50
# LINKEDIN_REIMPORT_DAYS=90
# University mail domains, `domain=Institution`, comma-separated. Empty until given (M7-T10).
# UNIVERSITY_DOMAINS=
# ACCOUNT_TOMBSTONE_TTL_S=7200   # how long a deleted account's token is refused (AUTH0_DELETE_USERS only); access tokens live 3600 s
# AUTH0_DELETE_USERS=false   # true: account deletion also deletes the Auth0 user (needs delete:users on the M2M app, M7-T13)
