### api/health -- every request the module serves
#
# Both paths sit outside /v1 on purpose: a platform's health probe should not
# have to change when the API version does.

@baseUrl = {{$dotenv baseUrl}}

###
# @name liveness
# 200 {"status":"ok"}. Stays 200 while the database is down -- restarting the
# api would not help.
GET {{baseUrl}}/healthz

###
# @name readiness
# 200 {"status":"ok","database":"ok"}, or 503 DATABASE_UNAVAILABLE.
#
# To see the failing case:
#   docker compose stop mysql    # readyz -> 503, healthz stays 200
#   docker compose start mysql   # readyz -> 200 again, no api restart
GET {{baseUrl}}/readyz

###
# @name livenessUnderPrefix
# 404. The health paths exist at the root and only at the root.
GET {{baseUrl}}/v1/healthz
