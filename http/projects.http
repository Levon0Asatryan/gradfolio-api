### api/projects -- reading projects (M4 PR a)
#
# Needs an Auth0 access token for the /me routes (see me.http). Put a project id in
# .env as `projectId=…` and a user id as `userId=…`.

@baseUrl = {{$dotenv baseUrl}}
@accessToken = {{$dotenv accessToken}}
@projectId = {{$dotenv projectId}}
@userId = {{$dotenv userId}}

###
# @name getProject
# 200 a public, published project, no token needed. A token, when sent, identifies the
# owner, who also reads private and draft projects. Anyone else gets 404, the same
# body as an unknown id. A bad token is 401, never anonymous.
GET {{baseUrl}}/v1/projects/{{projectId}}

###
# @name getProjectAsOwner
GET {{baseUrl}}/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}

###
# @name listMyProjects
# 200 { items, nextCursor }: the caller's projects in every state. Filters: state
# (published|private|draft), category, status, tag, technology, q. Sort: newest
# (default), oldest, updated, name_asc, name_desc. Pass nextCursor back as cursor with
# the same sort; a cursor for another sort, an unknown key, or limit over the maximum is 400.
GET {{baseUrl}}/v1/me/projects?sort=name_asc&limit=10
Authorization: Bearer {{accessToken}}

###
# @name listMyDrafts
GET {{baseUrl}}/v1/me/projects?state=draft&q=garden
Authorization: Bearer {{accessToken}}

###
# @name listUserProjects
# 200 the user's public, published projects, no token needed. 404 when the user's profile
# is private (and the caller is not its owner) or the user does not exist.
GET {{baseUrl}}/v1/users/{{userId}}/projects?category=research&technology=python

###
# @name nextPage
# nextCursor from the previous response
GET {{baseUrl}}/v1/me/projects?limit=10&cursor=PASTE_NEXT_CURSOR_HERE
Authorization: Bearer {{accessToken}}

###
# @name createProject
# 201 the new project (ProjectDetail). Only `title` is required; a new project is
# public and published. descriptionHtml is sanitized on the way in (allow-list in
# docs/m4-plan.md §4.1); the response shows what was kept. Unknown keys, id, userId,
# source, repo fields and aiSummary are 400. 409 LIMIT_REACHED at the per-user cap.
POST {{baseUrl}}/v1/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Smart Garden",
  "summary": "Waters plants by soil moisture.",
  "descriptionHtml": "<h2>Why</h2><p>Because <strong>plants</strong> need water. <a href=\"https://example.com\">Docs</a></p>",
  "category": "research",
  "status": "ongoing",
  "isPublic": true,
  "isDraft": false,
  "liveDemoUrl": "https://demo.example/",
  "repoUrl": "https://github.com/example/garden",
  "heroImageUrl": "https://img.example/hero.png",
  "metadata": { "startDate": "2025-01-15", "endDate": null, "course": "IoT 101", "professor": "Dr. H" },
  "technologies": ["Arduino", "Python"],
  "tags": ["iot", "garden"],
  "links": [{ "label": "Docs", "url": "https://docs.example/" }]
}

###
# @name updateProject
# 200 the project after the change. Any non-empty subset; metadata merges per key;
# technologies, tags, links and files are replaced as whole lists. Validated as a
# whole (endDate cannot precede the stored startDate). 404 for someone else's project.
PATCH {{baseUrl}}/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "completed",
  "metadata": { "endDate": "2025-06-01" },
  "tags": ["iot"]
}

###
# @name publishDraft
PATCH {{baseUrl}}/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "isDraft": false }

###
# @name makePrivate
# the project answers 404 to everyone but the owner at once
PATCH {{baseUrl}}/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "isPublic": false }

###
# @name deleteProject
# 204; attachments, tags, technologies and team rows go with it. 404 if not the caller's.
DELETE {{baseUrl}}/v1/projects/{{projectId}}
Authorization: Bearer {{accessToken}}
