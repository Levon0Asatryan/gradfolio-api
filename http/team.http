### api/team -- the owner's view of a project's memberships (M5)
#
# Needs an Auth0 access token (see me.http). Put a project id in .env as `projectId=…`.
# Accepted members also appear on GET /v1/projects/:id (team[]). The invitee requests need a
# second account's token (`inviteeToken=…` in .env).

@baseUrl = {{$dotenv baseUrl}}
@accessToken = {{$dotenv accessToken}}
@projectId = {{$dotenv projectId}}
@userId = {{$dotenv userId}}
@memberId = {{$dotenv memberId}}
@inviteeToken = {{$dotenv inviteeToken}}

###
# @name listProjectTeam
# 200 { items: [{ id, name, role, status, userId, avatarUrl, createdAt }] }: every row,
# pending/accepted/rejected. Owner only: another user's project (and one's own membership
# of it) answers 404, the same body as an unknown id. 401 without a token.
GET {{baseUrl}}/v1/projects/{{projectId}}/team
Authorization: Bearer {{accessToken}}

###
# @name lookupUsers
# 200 { items: [{ id, name, headline, avatarUrl }] }: at most 8 public profiles whose name
# starts with q (at least 3 characters), never yourself. Own rate budget. 400 for a short q.
GET {{baseUrl}}/v1/users/lookup?q=ani
Authorization: Bearer {{accessToken}}

###
# @name inviteTeamMember
# 201 the pending membership. Owner only (anyone else: 404). The invitee is notified in the
# same transaction. 400: your own id. 404: unknown or private user. 409: ALREADY_MEMBER
# (pending or accepted), TEAM_FULL, PROJECT_IS_DRAFT. A rejected user is invited again.
POST {{baseUrl}}/v1/projects/{{projectId}}/team
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "userId": "{{userId}}", "role": "Backend" }

###
# @name addExternalTeamMember
# 201 an accepted membership with no account: a name only, nobody is notified.
POST {{baseUrl}}/v1/projects/{{projectId}}/team/external
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "Aram Manukyan", "role": "QA" }

###
# @name removeTeamMember
# 204. Owner only; any status. 404 for another project's member id.
DELETE {{baseUrl}}/v1/projects/{{projectId}}/team/{{memberId}}
Authorization: Bearer {{accessToken}}

###
# @name acceptTeamInvitation
# Run as the INVITEE. 200 the accepted membership; the owner is notified. 404: no invitation
# for you. 409 INVITE_NOT_PENDING: already answered.
POST {{baseUrl}}/v1/projects/{{projectId}}/team/me/accept
Authorization: Bearer {{inviteeToken}}

###
# @name rejectTeamInvitation
# Run as the INVITEE. As accept; the owner may invite you again.
POST {{baseUrl}}/v1/projects/{{projectId}}/team/me/reject
Authorization: Bearer {{inviteeToken}}

###
# @name leaveProjectTeam
# Run as an ACCEPTED teammate. 204; the owner is notified. 404 for anyone else.
DELETE {{baseUrl}}/v1/projects/{{projectId}}/team/me
Authorization: Bearer {{inviteeToken}}
